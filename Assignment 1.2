""""Choosing a container"""

# Class roster: a list

class_roster = ["Juan", "Luis", "Maria", "Pedro", "Renato"]
class_roster.append("Brito")
print ("class Roster:", class_roster)

# Unique visitor ID's : a set

visitors = {"AU001", "AU002", "AU003", "AU004"}
visitors.remove("AU002")
visitors.add("AU003")
print ("visitors:", visitors)

# Student ID to name: a Directory
student_lookup = {
    "1AU": "Valera",
    "2AU": "Pedri",
    "3AU": "Pacho",
}
print("Student 2AU:", student_lookup["2AU"])

# Fixed weekday labels: a tuple
weekdays = (
    "Monday",
    "Tuesday",
    "Wednesday",
    "Thursday",
    "Friday",
    "Saturday",
    "Sunday"
)
print ("Weekdays:", weekdays)

